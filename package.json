{
  "name": "dsh-typing-studio",
  "version": "1.2.0",
  "description": "Bilingual Chinese and English typing practice for DeepSeek Harness, with timed passages, pinyin guides for Chinese, IME-aware scoring, and local records.",
  "type": "module",
  "license": "MIT",
  "author": "KeyFlow contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/654970/dsh-typing-studio.git"
  },
  "homepage": "https://github.com/654970/dsh-typing-studio#readme",
  "bugs": {
    "url": "https://github.com/654970/dsh-typing-studio/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "typing",
    "typing-practice",
    "chinese",
    "english"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
